///|
/// Status text message.
/// - MAVLink Message `STATUSTEXT` (ID: 253, CRC_EXTRA: 83, base_len: 51B, max_len: 54B)
pub(all) struct Statustext {
  severity : Byte
  text : String
  id : UInt32
  chunk_seq : Byte
} derive(Eq, Debug)

///|
pub extend Statustext with Eq::{not_equal, equal}

