///|
/// Look up the precomputed `CRC_EXTRA` byte for a known MAVLink message ID.
pub fn lookup_message_crc_extra(msgid : UInt32) -> Byte? {
  match msgid {
    0U => Some(Heartbeat::crc_extra())
    1U => Some(SysStatus::crc_extra())
    4U => Some(Ping::crc_extra())
    20U => Some(ParamRequestRead::crc_extra())
    22U => Some(ParamValue::crc_extra())
    24U => Some(GpsRawInt::crc_extra())
    30U => Some(Attitude::crc_extra())
    33U => Some(GlobalPositionInt::crc_extra())
    76U => Some(CommandLong::crc_extra())
    77U => Some(CommandAck::crc_extra())
    253U => Some(Statustext::crc_extra())
    268U => Some(LoggingAck::crc_extra())
    _ => None
  }
}

///|
/// Unified top-level MAVLink dialect message sum type.
pub(all) enum MavMessage {
  MsgHeartbeat(Heartbeat)
  MsgSysStatus(SysStatus)
  MsgPing(Ping)
  MsgParamRequestRead(ParamRequestRead)
  MsgParamValue(ParamValue)
  MsgGpsRawInt(GpsRawInt)
  MsgAttitude(Attitude)
  MsgGlobalPositionInt(GlobalPositionInt)
  MsgCommandLong(CommandLong)
  MsgCommandAck(CommandAck)
  MsgStatustext(Statustext)
  MsgLoggingAck(LoggingAck)
} derive(Eq, Debug)

///|
pub extend MavMessage with Eq::{not_equal, equal}

///|
pub extend MavMessage with @debug.Debug::{to_repr}

///|
/// Return the numeric MAVLink message ID of `self`.
pub fn MavMessage::msg_id(self : MavMessage) -> UInt32 {
  match self {
    MsgHeartbeat(_) => 0U
    MsgSysStatus(_) => 1U
    MsgPing(_) => 4U
    MsgParamRequestRead(_) => 20U
    MsgParamValue(_) => 22U
    MsgGpsRawInt(_) => 24U
    MsgAttitude(_) => 30U
    MsgGlobalPositionInt(_) => 33U
    MsgCommandLong(_) => 76U
    MsgCommandAck(_) => 77U
    MsgStatustext(_) => 253U
    MsgLoggingAck(_) => 268U
  }
}

///|
/// Return the `CRC_EXTRA` seed byte of `self`.
pub fn MavMessage::crc_extra(self : MavMessage) -> Byte {
  match self {
    MsgHeartbeat(_) => Heartbeat::crc_extra()
    MsgSysStatus(_) => SysStatus::crc_extra()
    MsgPing(_) => Ping::crc_extra()
    MsgParamRequestRead(_) => ParamRequestRead::crc_extra()
    MsgParamValue(_) => ParamValue::crc_extra()
    MsgGpsRawInt(_) => GpsRawInt::crc_extra()
    MsgAttitude(_) => Attitude::crc_extra()
    MsgGlobalPositionInt(_) => GlobalPositionInt::crc_extra()
    MsgCommandLong(_) => CommandLong::crc_extra()
    MsgCommandAck(_) => CommandAck::crc_extra()
    MsgStatustext(_) => Statustext::crc_extra()
    MsgLoggingAck(_) => LoggingAck::crc_extra()
  }
}

///|
/// Encode `self` into a wire payload.
pub fn MavMessage::encode_payload(
  self : MavMessage,
  v2~ : Bool = true,
) -> Bytes {
  match self {
    MsgHeartbeat(m) => m.encode_payload(v2~)
    MsgSysStatus(m) => m.encode_payload(v2~)
    MsgPing(m) => m.encode_payload(v2~)
    MsgParamRequestRead(m) => m.encode_payload(v2~)
    MsgParamValue(m) => m.encode_payload(v2~)
    MsgGpsRawInt(m) => m.encode_payload(v2~)
    MsgAttitude(m) => m.encode_payload(v2~)
    MsgGlobalPositionInt(m) => m.encode_payload(v2~)
    MsgCommandLong(m) => m.encode_payload(v2~)
    MsgCommandAck(m) => m.encode_payload(v2~)
    MsgStatustext(m) => m.encode_payload(v2~)
    MsgLoggingAck(m) => m.encode_payload(v2~)
  }
}

///|
/// Encode `self` into a complete MAVLink v1 or v2 wire frame.
pub fn MavMessage::encode_to_frame(
  self : MavMessage,
  seq~ : Byte,
  sysid~ : Byte,
  compid~ : Byte,
  version~ : ProtocolVersion = V2,
  signing~ : SigningContext? = None,
) -> Result[(Bytes, MavFrame), MavError] {
  let is_v2 = version == V2
  let raw_payload = self.encode_payload(v2=is_v2)
  let header : MavHeader = {
    version,
    incompat_flags: b'\x00',
    compat_flags: b'\x00',
    seq,
    sysid,
    compid,
    msgid: self.msg_id(),
  }
  encode_frame(
    header,
    raw_payload,
    self.crc_extra(),
    truncate_v2_zeros=is_v2,
    signing~,
  )
}

///|
/// Decode a `MavMessage` from a verified `MavFrame`.
pub fn MavMessage::decode_from_frame(
  frame : MavFrame,
) -> Result[MavMessage, MavError] {
  let is_v2 = frame.header.version == V2
  match frame.header.msgid {
    0U =>
      match Heartbeat::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgHeartbeat(m))
        Err(e) => Err(e)
      }
    1U =>
      match SysStatus::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgSysStatus(m))
        Err(e) => Err(e)
      }
    4U =>
      match Ping::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgPing(m))
        Err(e) => Err(e)
      }
    20U =>
      match ParamRequestRead::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgParamRequestRead(m))
        Err(e) => Err(e)
      }
    22U =>
      match ParamValue::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgParamValue(m))
        Err(e) => Err(e)
      }
    24U =>
      match GpsRawInt::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgGpsRawInt(m))
        Err(e) => Err(e)
      }
    30U =>
      match Attitude::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgAttitude(m))
        Err(e) => Err(e)
      }
    33U =>
      match GlobalPositionInt::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgGlobalPositionInt(m))
        Err(e) => Err(e)
      }
    76U =>
      match CommandLong::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgCommandLong(m))
        Err(e) => Err(e)
      }
    77U =>
      match CommandAck::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgCommandAck(m))
        Err(e) => Err(e)
      }
    253U =>
      match Statustext::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgStatustext(m))
        Err(e) => Err(e)
      }
    268U =>
      match LoggingAck::decode_payload(frame.payload, v2=is_v2) {
        Ok(m) => Ok(MsgLoggingAck(m))
        Err(e) => Err(e)
      }
    other => Err(UnknownMessageId(other))
  }
}
