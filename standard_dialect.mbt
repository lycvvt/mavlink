  let time_boot_ms = match reader_.read_uint32() {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let q = FixedArray::make(4, (0.0 : Float))
  for idx_ = 0; idx_ < 4; idx_ = idx_ + 1 {
    match reader_.read_float() {
      Ok(v) => q[idx_] = v
      Err(e) => return Err(e)
    }
